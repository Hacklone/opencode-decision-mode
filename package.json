      "optional": true
    },
    "@opentui/solid": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@opentui/core": "^0.5.8",
    "@opentui/solid": "^0.5.8",
    "@types/node": "^26.0.0",
    "@vitest/coverage-v8": "^3.2.4",
    "solid-js": "^1.9.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.4"
  }
