    "src"
  ],
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@opencode/plugin": "^2.0.32",
    "@openrouter/sdk": "^1.4.25",
    "@typesafe-ai/sdk": "^0.7.0",
